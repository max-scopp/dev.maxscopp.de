---
import Icon from './Icon.astro';
import { sparkle } from '../lib/ascii';

const art = sparkle(84, 42);
---

<section class="hero container">
  <div class="copy">
    <h1 data-reveal>
      <span class="kicker">AI-Native</span>
      Product <span class="gradient-text">Designer</span>
    </h1>
    <p class="formula" data-reveal style="--i:2">
      Design <span>×</span> Engineering <span>×</span> AI
    </p>
    <p class="pitch" data-reveal style="--i:2">
      10+ years across startups and enterprises, many teams and every kind of stack. I help you
      shape your vision and ship it faster with AI — without the chaos.{' '}
      <strong>Human, grounded, on the same page.</strong>
    </p>
    <div class="actions" data-reveal style="--i:3">
      <a class="btn btn--solid" href="/about">About Me <Icon name="arrow" size={16} /></a>
      <a class="btn" href="/contact">Get in Touch</a>
    </div>
  </div>

  <pre class="texture star" aria-hidden="true">{art}</pre>
</section>

<style>
  .hero {
    position: relative;
    display: flex;
    align-items: center;
    flex: 1;
    padding-block: 96px 32px;
  }
  .copy {
    position: relative;
    z-index: 1;
    max-width: 640px;
  }
  h1 {
    font-size: clamp(52px, 8.4vw, 100px);
    font-weight: 600;
    letter-spacing: -0.045em;
    line-height: 0.95;
    margin-left: -0.06em;
  }
  .kicker {
    margin: 0 0 20px calc(clamp(52px, 8.4vw, 100px) * 0.06);
  }
  h1 .gradient-text {
    display: inline-block;
    padding-bottom: 0.08em;
  }
  .formula {
    margin-top: 20px;
    font-size: clamp(20px, 2.2vw, 24px);
    letter-spacing: -0.02em;
    color: var(--ink-3);
  }
  .pitch {
    margin-top: 20px;
    max-width: 46ch;
    font-size: 17px;
    color: var(--ink-2);
  }
  .pitch strong {
    color: var(--ink);
    font-weight: 500;
  }
  .formula span {
    color: var(--violet);
  }
  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 36px;
  }

  .star {
    position: absolute;
    top: 50%;
    right: -4%;
    translate: 0 -50%;
    margin: 0;
    font-size: 10px;
    line-height: 1.15;
    letter-spacing: 0.08em;
    background: linear-gradient(135deg, #c4b5fd 10%, #a855f7 45%, #e879f9 70%, #c4b5fd 95%);
    background-size: 220% 220%;
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
    opacity: 0.75;
    mask-image: radial-gradient(closest-side, #000 55%, transparent);
    animation: shimmer 16s ease-in-out infinite alternate;
  }
  @keyframes shimmer {
    to {
      background-position: 100% 100%;
    }
  }

  @media (max-width: 960px) {
    .star {
      right: -40%;
      opacity: 0.35;
    }
  }
  @media (max-width: 600px) {
    .hero {
      overflow-x: clip;
      padding-top: 104px;
    }
    .star {
      top: 110px;
      translate: none;
      right: -55%;
      font-size: 8px;
    }
  }
</style>
